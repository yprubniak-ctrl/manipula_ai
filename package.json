{
  "name": "manipula-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic orchestration engine for end-to-end software development pipelines",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@manipula/orchestrator-engine",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "pipeline": "turbo run build --output-logs=errors-only && node packages/orchestrator/dist/cli/run.js",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.12.0"
}
